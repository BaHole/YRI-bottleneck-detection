#example blueprint file
#input setting
popid: Science_108samples # id of the population (no white space)
nseq: 216 # number of sequences
L: 826650000  # total number of observed nucleic sites, including polymorphic and monomorphic
whether_folded: false # whethr the SFS is folded (true or false)
SFS: 1240563 513182 344711 258539 209038 172717 147189 126709 112026 100013 90083 83295 75672 69337 63470 59902 55634 51077 49071 46084 43985 40813 39584 37437 36273 34199 32920 31463 29544 29058 28527 27469 26003 24928 24565 24209 22740 22065 21322 20857 19892 19167 19317 18136 17802 17420 17429 16082 15892 15502 15380 14860 14544 14316 13910 13947 14030 13243 12624 12445 12468 12231 11840 11722 11227 11311 11226 10836 10713 10705 10711 10359 10073 9863 9652 9678 9547 9299 9037 8840 8669 8661 8483 8394 8087 8420 8359 8242 7925 7812 7952 7559 7404 7487 7306 7576 6980 6951 7067 6990 6791 6912 6626 6516 6640 6267 6208 5791 5934 6125 6244 5916 6264 5912 5955 5985 5949 5599 5511 5903 5338 5551 5411 5443 5658 5314 5475 5286 5308 5241 4942 5106 5171 5049 5024 5000 5039 4984 4786 5007 4800 4829 4961 4960 4986 4778 4883 4826 4701 4773 4619 4639 4675 4739 4490 4488 4528 4620 4802 4373 4339 4486 4413 4802 4622 4337 4469 4582 4857 4453 4674 4539 4709 4507 4708 4660 4616 4426 4616 4597 4718 4559 4756 4774 4614 4710 4473 4754 4924 4972 5200 4836 5124 5142 5365 5393 5268 5671 5779 5872 5401 5506 6029 6347 6278 6554 7035 7320 7716 8582 9607 9872 12169 15233 26208 # snp frequency spectrum: number of singleton, number of doubleton, etc. (separated by white space)
#smallest_size_of_SFS_bin_used_for_estimation: 1 # default is 1; to ignore singletons, uncomment this line and change this number to 2
#largest_size_of_SFS_bin_used_for_estimation: 29 # default is n-1; to ignore singletons, uncomment this line and change this number to nseq-2
pct_training: 0.67 # percentage of sites for training
nrand: 54	107	161	214 # number of random break points for each try (separated by white space)
project_dir: Science_108samples # project directory
stairway_plot_dir: /data/taotz/soft/stairway_plot_v2.2/stairway_plot_es/ # directory to the stairway plot files
ninput: 200 # number of input files to be created for each estimation
theta_upper_bound: 0.2 # the maximum of theta used in the search algorithm, default is 0.2. Increase this value only if seeing confident intervals converged to the same value as a plateau on the plot.
dimension_factor: 2000 # this parameter determin the maximum number of iteration of the search algorithm, default is 2000.
#random_seed: 6
#output setting
mu: 1.25e-8 # assumed mutation rate per site per generation
year_per_generation: 29 # assumed generation time (in years)
#plot setting
plot_title: Science_108samples # title of the plot
xrange: 0.1,10000 # Time (1k year) range; format: xmin,xmax; "0,0" for default
yrange: 0,0 # Ne (1k individual) range; format: xmin,xmax; "0,0" for default
xspacing: 2 # X axis spacing
yspacing: 2 # Y axis spacing
fontsize: 12 # Font size
